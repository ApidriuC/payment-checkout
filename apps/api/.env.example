# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed by CORS (the SPA dev server by default).
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string. Managed providers require SSL.
DATABASE_URL=postgresql://user:password@host/database
DATABASE_SSL=true
DATABASE_LOGGING=false

# Payment gateway (sandbox environment).
PAYMENT_GATEWAY_BASE_URL=https://api-sandbox.example.dev/v1
PAYMENT_GATEWAY_PUBLIC_KEY=pub_test_replace_me
PAYMENT_GATEWAY_PRIVATE_KEY=prv_test_replace_me
PAYMENT_GATEWAY_INTEGRITY_KEY=integrity_replace_me
PAYMENT_GATEWAY_EVENTS_KEY=events_replace_me
PAYMENT_GATEWAY_TIMEOUT_MS=15000

# Order fees, in cents, applied to every checkout.
BASE_FEE_CENTS=500000
DELIVERY_FEE_CENTS=1000000
